<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <GeneDef>
        <defName>ESCP_Gene_Khajiit_Blood</defName>
        <label>Khajiit blood</label>
        <description>Khajiit feel the turning of the moons in their bones. Carriers are sensitive to mystical power, sit ill with strangers who think of them as thieves, and can run on moonlight for a short while.</description>
        <iconPath>UI/Icons/Genes/ESCP_Gene_Khajiit</iconPath>
        <displayCategory>Miscellaneous</displayCategory>
        <displayOrderInCategory>100</displayOrderInCategory>
        <biostatCpx>2</biostatCpx>
        <biostatMet>-1</biostatMet>
        <statOffsets>
            <PsychicSensitivity>0.2</PsychicSensitivity>
            <SocialImpact>-0.2</SocialImpact>
        </statOffsets>
        <abilities>
            <li>ESCP_Ability_Khajiit_MoonStride</li>
        </abilities>
    </GeneDef>

    <GeneDef>
        <defName>ESCP_Gene_Khajiit_Nimble</defName>
        <label>Khajiit nimbleness</label>
        <description>Soft paws and quick reflexes. Carriers move fast, step around blows and rarely set off a trap.</description>
        <iconPath>UI/Icons/Genes/Gene_Robust</iconPath>
        <displayCategory>Miscellaneous</displayCategory>
        <displayOrderInCategory>101</displayOrderInCategory>
        <biostatCpx>1</biostatCpx>
        <biostatMet>-2</biostatMet>
        <statOffsets>
            <MoveSpeed>0.2</MoveSpeed>
            <MeleeDodgeChance>5</MeleeDodgeChance>
            <PawnTrapSpringChance>-0.3</PawnTrapSpringChance>
        </statOffsets>
    </GeneDef>

    <GeneDef>
        <defName>ESCP_Gene_Khajiit_Hair</defName>
        <label>Khajiit grooming</label>
        <description>Carriers only wear Khajiiti hair and whisker styles.</description>
        <iconPath>UI/Icons/Genes/Gene_HairStyleBaldOnly</iconPath>
        <iconColor>(0.75, 0.75, 0.75)</iconColor>
        <displayCategory>Cosmetic</displayCategory>
        <biostatCpx>0</biostatCpx>
        <exclusionTags>
            <li>HairStyle</li>
        </exclusionTags>
        <hairTagFilter>
            <whitelist>true</whitelist>
            <tags>
                <li>Bald</li>
                <li>ESCP_Khajiit</li>
            </tags>
        </hairTagFilter>
        <beardTagFilter>
            <whitelist>true</whitelist>
            <tags>
                <li>NoBeard</li>
                <li>ESCP_Khajiit</li>
            </tags>
        </beardTagFilter>
    </GeneDef>

    <GeneDef>
        <defName>ESCP_Gene_Khajiit_Fur</defName>
        <label>Khajiit fur</label>
        <description>Carriers are covered head to toe in soft fur, with the broad face and whiskers of a great cat.</description>
        <iconPath>UI/Icons/Genes/Gene_Furskin</iconPath>
        <displayCategory>Cosmetic</displayCategory>
        <biostatCpx>0</biostatCpx>
        <fur>ESCP_Fur_Khajiit</fur>
        <skinIsHairColor>true</skinIsHairColor>
        <tattoosVisible>false</tattoosVisible>
        <exclusionTags>
            <li>Head</li>
        </exclusionTags>
        <forcedHeadTypes>
            <li>ESCP_HeadKhajiit_Female_Average_Normal</li>
            <li>ESCP_HeadKhajiit_Female_Average_Pointy</li>
            <li>ESCP_HeadKhajiit_Female_Average_Wide</li>
            <li>ESCP_HeadKhajiit_Male_Average_Normal</li>
            <li>ESCP_HeadKhajiit_Male_Average_Pointy</li>
            <li>ESCP_HeadKhajiit_Male_Average_Wide</li>
        </forcedHeadTypes>
        <renderNodeProperties>
            <li Class="ESCP.Core.PawnRenderNodeProperties_FurPattern">
                <nodeClass>ESCP.Core.PawnRenderNode_FurPattern</nodeClass>
                <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
                <texPath>Things/Pawn/Humanlike/ESCP_Khajiit/Bodies/Masks/BodyPattern_</texPath>
                <variants>5</variants>
                <parentTagDef>Body</parentTagDef>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <drawData>
                    <defaultData>
                        <layer>1</layer>
                    </defaultData>
                </drawData>
            </li>
            <li Class="ESCP.Core.PawnRenderNodeProperties_FurPattern">
                <nodeClass>ESCP.Core.PawnRenderNode_FurPattern</nodeClass>
                <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
                <texPath>Things/Pawn/Humanlike/ESCP_Khajiit/Heads/Masks/FacePattern_</texPath>
                <onHead>true</onHead>
                <variants>5</variants>
                <parentTagDef>Head</parentTagDef>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <drawData>
                    <defaultData>
                        <layer>1</layer>
                    </defaultData>
                </drawData>
            </li>
        </renderNodeProperties>
    </GeneDef>

