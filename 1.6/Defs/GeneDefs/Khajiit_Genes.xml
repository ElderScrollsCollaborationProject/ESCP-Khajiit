    <GeneDef>
        <defName>ESCP_Gene_Khajiit_Quadruped</defName>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <label>quadruped frame</label>
        <description>Carriers walk on four paws. They cannot manage tools, fine work or a bowstring, and tending a wound without thumbs is a slow business. Oratory and fighting are another matter.</description>
        <iconPath>UI/Icons/Genes/Gene_Robust</iconPath>
        <displayCategory>Miscellaneous</displayCategory>
        <displayOrderInCategory>102</displayOrderInCategory>
        <biostatCpx>1</biostatCpx>
        <biostatMet>2</biostatMet>
        <disabledWorkTags>Constructing, Cooking, Crafting, Mining, Shooting</disabledWorkTags>
        <statFactors>
            <MedicalSurgerySuccessChance>0.5</MedicalSurgerySuccessChance>
        </statFactors>
    </GeneDef>

