<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <FactionDef ParentName="FactionBase">
        <defName>ESCP_Faction_Elsweyr</defName>
        <label>Elsweyr Confederacy</label>
        <description>The Elsweyr Confederacy joined Anequina's desert clans and Pelletine's rich river cities into sixteen kingdoms under the moons. The Mane is their spiritual head and the clan mothers run nearly everything else. Traders are welcome, thieves are expected, and a Khajiit will take insult at being compared to a common cat.</description>
        <colorSpectrum>
            <li>(0.86, 0.68, 0.22)</li>
        </colorSpectrum>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <pawnSingular>Khajiit</pawnSingular>
        <pawnsPlural>Khajiit</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <settlementGenerationWeight>0.3</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <leaderTitle>Mane</leaderTitle>
        <factionIconPath>World/WorldObjects/ESCP_Khajiit_Kingdom</factionIconPath>
        <techLevel>Medieval</techLevel>
        <fixedName>Elsweyr Confederacy</fixedName>
        <allowedCultures>
            <li>ESCP_Culture_Khajiit</li>
        </allowedCultures>

        <royalTitleTags>
            <li>ESCP_Title_Khajiit</li>
        </royalTitleTags>
        <royalFavorLabel>Clan Standing</royalFavorLabel>
        <royalTitleInheritanceWorkerClass>RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>

        <fixedIdeo>true</fixedIdeo>
        <ideoName>The Lunar Lattice</ideoName>
        <ideoDescription>Jone and Jode set the shape of every cub born under them. The Lunar Lattice holds the world in its proper order, and a Khajiit who strays from it may end up walking the Sands Behind the Stars.</ideoDescription>
        <deityPresets>
            <li>
                <nameType><name>Ja-Kha'jay</name><type>the Lunar Lattice</type></nameType>
                <gender>Female</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
            <li>
                <nameType><name>Alkosh</name><type>Dragon King of Cats</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
            <li>
                <nameType><name>Khenarthi</name><type>Queen of the Winds</type></nameType>
                <gender>Female</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
        </deityPresets>
        <styles>
            <li>ESCP_Style_Khajiit</li>
        </styles>
        <forcedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">ESCP_Meme_KhajiitMoons</li>
        </forcedMemes>
        <requiredPreceptsOnly>true</requiredPreceptsOnly>

        <backstoryFilters>
            <li>
                <categories>
                    <li>ESCP_Backstory_Khajiit_Child</li>
                    <li>ESCP_Backstory_Khajiit_Citizen</li>
                    <li>ESCP_Backstory_Khajiit_Military</li>
                    <li>ESCP_Backstory_Khajiit_Mage</li>
                </categories>
            </li>
        </backstoryFilters>

        <caravanTraderKinds>
            <li>ESCP_Caravan_Khajiit_Trader</li>
        </caravanTraderKinds>
        <visitorTraderKinds>
            <li>ESCP_Caravan_Khajiit_Trader</li>
        </visitorTraderKinds>
        <baseTraderKinds>
            <li>ESCP_Caravan_Khajiit_Trader</li>
        </baseTraderKinds>

        <allowedArrivalTemperatureRange>-20~50</allowedArrivalTemperatureRange>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <options>
                    <ESCP_Pawnkind_Khajiit_Melee>10</ESCP_Pawnkind_Khajiit_Melee>
                    <ESCP_Pawnkind_Khajiit_Senche>3</ESCP_Pawnkind_Khajiit_Senche>
                    <ESCP_Pawnkind_Khajiit_Ranged>7</ESCP_Pawnkind_Khajiit_Ranged>
                    <ESCP_Pawnkind_Khajiit_Mage>4</ESCP_Pawnkind_Khajiit_Mage>
                    <ESCP_Pawnkind_Khajiit_Captain>3</ESCP_Pawnkind_Khajiit_Captain>
                    <ESCP_Pawnkind_Khajiit_Elite>2</ESCP_Pawnkind_Khajiit_Elite>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <ESCP_Pawnkind_Khajiit_Citizen>15</ESCP_Pawnkind_Khajiit_Citizen>
                    <ESCP_Pawnkind_Khajiit_Alfiq>2</ESCP_Pawnkind_Khajiit_Alfiq>
                    <ESCP_Pawnkind_Khajiit_Merchant>6</ESCP_Pawnkind_Khajiit_Merchant>
                    <ESCP_Pawnkind_Khajiit_Noble>4</ESCP_Pawnkind_Khajiit_Noble>
                    <ESCP_Pawnkind_Khajiit_Mage>3</ESCP_Pawnkind_Khajiit_Mage>
                </options>
            </li>
            <li>
                <kindDef>Trader</kindDef>
                <traders>
                    <ESCP_Pawnkind_Khajiit_Trader>1</ESCP_Pawnkind_Khajiit_Trader>
                    <ESCP_Pawnkind_Khajiit_Quartermaster>1</ESCP_Pawnkind_Khajiit_Quartermaster>
                </traders>
                <carriers>
                    <Muffalo>6</Muffalo>
                    <Dromedary>5</Dromedary>
                    <Alpaca>3</Alpaca>
                </carriers>
                <guards>
                    <ESCP_Pawnkind_Khajiit_Melee>8</ESCP_Pawnkind_Khajiit_Melee>
                    <ESCP_Pawnkind_Khajiit_Senche>3</ESCP_Pawnkind_Khajiit_Senche>
                    <ESCP_Pawnkind_Khajiit_Ranged>5</ESCP_Pawnkind_Khajiit_Ranged>
                    <ESCP_Pawnkind_Khajiit_Elite>1</ESCP_Pawnkind_Khajiit_Elite>
                </guards>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <ESCP_Pawnkind_Khajiit_Citizen>8</ESCP_Pawnkind_Khajiit_Citizen>
                    <ESCP_Pawnkind_Khajiit_Alfiq>2</ESCP_Pawnkind_Khajiit_Alfiq>
                    <ESCP_Pawnkind_Khajiit_Melee>10</ESCP_Pawnkind_Khajiit_Melee>
                    <ESCP_Pawnkind_Khajiit_Senche>3</ESCP_Pawnkind_Khajiit_Senche>
                    <ESCP_Pawnkind_Khajiit_Ranged>8</ESCP_Pawnkind_Khajiit_Ranged>
                    <ESCP_Pawnkind_Khajiit_Mage>4</ESCP_Pawnkind_Khajiit_Mage>
                    <ESCP_Pawnkind_Khajiit_Elite>2</ESCP_Pawnkind_Khajiit_Elite>
                </options>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>

        <modExtensions Inherit="False">
            <li Class="ESCP_RaceTools.FactionProperties">
                <factionTags>
                    <li>ESCP_Aldmeri</li>
                    <li>ESCP_MoonSugar</li>
                </factionTags>
            </li>
            <li Class="ESCP.Factions.FactionExtension_FlavorOverride">
                <newLabel>Elsweyr Confederacy</newLabel>
            </li>
            <li Class="ESCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <li Class="ESCP.Enlist.FactionEnlistOptions">
                <enlistOptionsDefs>
                    <li>ESCP_Enlistment_Elsweyr</li>
                </enlistOptionsDefs>
            </li>
            <li Class="ESCP.Ranks.FactionExtension_RankTracks">
                <rankTracks>
                    <li>ESCP_RankTrack_Elsweyr</li>
                </rankTracks>
            </li>
            <li Class="ESCP.Factions.FactionExtension_NamedSettlement">
                <settlementNames>
                    <li>Rimmen</li>
                    <li>Riverhold</li>
                    <li>Dune</li>
                    <li>Orcrest</li>
                    <li>Corinthe</li>
                    <li>Senchal</li>
                    <li>Torval</li>
                    <li>Khuul</li>
                </settlementNames>
                <preferredHilliness />
                <allowedBiomes>
                    <li>AridShrubland</li>
                    <li>Desert</li>
                    <li>TropicalRainforest</li>
                </allowedBiomes>
                <clustered>true</clustered>
            </li>
        </modExtensions>
    </FactionDef>

</Defs>
